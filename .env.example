# Placeholders only. Never put real secrets here; API keys go to the OS credential store.
# Development only: fixed session token for the dev server (packaged builds generate a random one per launch).
OSINTCC_SESSION_TOKEN=dev-token-local-only
# Override the data directory (default: %APPDATA%\osintcc or ~/.local/share/osintcc).
OSINTCC_DATA_DIR=./data/dev
OSINTCC_PORT=8791
