{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OSINT Command Center",
  "version": "0.1.0",
  "identifier": "local.osintcc.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OSINT Command Center",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeSync,msEdgeShopping,OptimizationHints,Translate,MediaRouter,msUndersideSidebar,msEdgeAutofillServer,msEdgeDiscoverFeed --disable-background-networking --disable-component-update --disable-sync --no-pings --disable-domain-reliability --disable-breakpad --disable-default-apps --no-default-browser-check --disable-client-side-phishing-detection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
