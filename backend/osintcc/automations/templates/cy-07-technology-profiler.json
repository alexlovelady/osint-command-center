{
 "slug": "cy-07-technology-profiler",
 "key": "CY-07",
 "version": 1,
 "category": "Cyber",
 "name": "Technology Profiler",
 "description": "Collects public certificate and scan-service signals about a domain's technology with a minimal number of requests.",
 "catalog_trigger": "Manual",
 "tags": [
  "recon",
  "passive"
 ],
 "dependencies": [
  "dns"
 ],
 "optional_dependencies": [
  "crtsh",
  "urlscan"
 ],
 "inputs": [
  {
   "name": "domain",
   "label": "Domain you own or are authorised to examine",
   "type": "domain",
   "required": true,
   "example": "example.org"
  }
 ],
 "legal_notes": "Public, passive sources only. Respect each source's terms and keep to targets you own or have a documented reason to examine.",
 "quota_note": "About 3 source request(s) per run",
 "example_output": "Hosts, addresses and any technology hints urlscan returns, with confidence labels.",
 "capability_gaps": [
  "No HTTP response-header fingerprinting adapter exists yet; signals come from certificates, DNS and the optional urlscan.io service."
 ],
 "instructions": "Collects public certificate and scan-service signals about a domain's technology with a minimal number of requests.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "cy-07-technology-profiler",
  "name": "Technology Profiler",
  "description": "Collects public certificate and scan-service signals about a domain's technology with a minimal number of requests.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "recon",
   "passive"
  ],
  "trigger": {
   "type": "manual",
   "enabled": false
  },
  "inputs": {
   "domain": "example.org"
  },
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "scope",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "crtsh",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "crtsh",
     "target_ref": "$inputs.domain"
    },
    "optional": true
   },
   {
    "id": "dns",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "dns",
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "urlscan",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "urlscan",
     "target_ref": "$inputs.domain"
    },
    "optional": true
   },
   {
    "id": "merged",
    "type": "transform",
    "depends_on": [
     "crtsh",
     "dns",
     "urlscan"
    ],
    "config": {
     "ref": "$nodes.crtsh.output",
     "extra_refs": [
      "$nodes.dns.output",
      "$nodes.urlscan.output"
     ],
     "op": "merge"
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "merged"
    ],
    "config": {
     "ref": "$nodes.merged.output"
    }
   },
   {
    "id": "save",
    "type": "evidence_save",
    "depends_on": [
     "unique"
    ],
    "config": {
     "ref": "$nodes.unique.output",
     "title": "Technology signals"
    }
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {
   "domain": "example.org"
  },
  "adapter_findings": {
   "crtsh": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "cert.subdomain",
     "value": "www.example.org",
     "confidence": "medium"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "cert.subdomain",
     "value": "mail.example.org",
     "confidence": "medium"
    }
   ],
   "dns": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "dns.a",
     "value": "192.0.2.10",
     "confidence": "high"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "dns.mx",
     "value": "mail.example.org",
     "confidence": "high"
    }
   ],
   "urlscan": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "web.server",
     "value": "nginx",
     "confidence": "low"
    }
   ]
  }
 }
}
