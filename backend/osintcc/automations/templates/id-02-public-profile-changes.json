 ],
 "dependencies": [
  "sherlock"
 ],
 "optional_dependencies": [],
 "inputs": [
  {
   "name": "username",
   "label": "Username (with consent or a documented case basis)",
   "type": "username",
   "required": true,
   "example": "alice"
  }
 ],
 "legal_notes": "Recurring monitoring of a person needs a documented purpose and their consent or a legitimate basis. It never logs in or bypasses access controls.",
 "quota_note": "About 1 source request(s) per run",
 "example_output": "A de-duplicated dataset saved as evidence, with every finding linked to its source response.",
 "capability_gaps": [],
 "instructions": "Re-checks which public profiles exist for an opted-in username and reports changes.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "id-02-public-profile-changes",
  "name": "Public Profile Changes",
  "description": "Re-checks which public profiles exist for an opted-in username and reports changes.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "identity",
   "monitor"
  ],
  "trigger": {
   "type": "schedule",
   "schedule": "0 10 * * 1",
   "timezone": "UTC",
   "enabled": false,
   "missed_run_policy": "coalesce"
  },
  "inputs": {
   "username": "alice"
  },
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "scope",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.username",
     "target_type": "username"
    }
   },
   {
    "id": "sherlock",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "sherlock",
     "target_ref": "$inputs.username",
     "target_type": "username"
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "sherlock"
    ],
    "config": {
     "ref": "$nodes.sherlock.output"
    }
   },
   {
    "id": "diff",
    "type": "snapshot_diff",
    "depends_on": [
     "unique"
    ],
    "config": {
     "dataset_ref": "$nodes.unique.output"
    }
   },
   {
    "id": "notify",
    "type": "notification",
    "depends_on": [
     "diff"
    ],
    "config": {
     "change_ref": "$nodes.diff.output",
     "title": "Public profile change",
     "severity": "info",
     "channel": "local_desktop",
     "only_if_changed": true
    }
   },
   {
    "id": "fail",
    "type": "error_handler",
    "depends_on": [
     "unique",
     "diff"
    ],
    "config": {
     "title": "Profile change watch failed"
    },
    "run_on": "failure"
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {
   "username": "alice"
  },
  "adapter_findings": {
   "sherlock": [
    {
     "entity": "alice",
     "entity_type": "account",
     "predicate": "account.profile",
     "value": "https://social.example/alice",
     "confidence": "low"
    }
   ]
  },
  "previous_snapshot": []
 }
}
