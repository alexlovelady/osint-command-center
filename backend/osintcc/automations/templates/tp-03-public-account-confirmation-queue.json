 "definition": {
  "schema_version": 1,
  "workflow_key": "tp-03-public-account-confirmation-queue",
  "name": "Public Account Confirmation Queue",
  "description": "Offline: clusters candidate accounts already found in the case by canonical URL and routes them to ownership review.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "target-profile",
   "review"
  ],
  "trigger": {
   "type": "manual",
   "enabled": false
  },
  "inputs": {},
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "cands",
    "type": "case_findings",
    "depends_on": [],
    "config": {
     "entity_types": [
      "url"
     ],
     "predicates": [
      "profile.candidate"
     ]
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "cands"
    ],
    "config": {
     "ref": "$nodes.cands.output"
    }
   },
   {
    "id": "queue",
    "type": "analyst_review",
    "depends_on": [
     "unique"
    ],
    "config": {
     "prompt": "Open Target profile > Review queue. Nothing is merged automatically; decide each account on evidence.",
     "timeout_hours": 168
    }
   },
   {
    "id": "save",
    "type": "evidence_save",
    "depends_on": [
     "queue",
     "unique"
    ],
    "config": {
     "ref": "$nodes.unique.output",
     "title": "Candidate accounts queued for review (unconfirmed)"
    }
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
