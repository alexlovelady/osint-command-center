{
 "slug": "tp-04-owned-domain-and-company-linkage",
 "key": "TP-04",
 "version": 1,
 "category": "Target profile",
 "name": "Owned Domain and Company Linkage",
 "description": "Passive registry and DNS data for a domain the subject owns, plus an optional company record. Affiliation stays claimed until corroborated.",
 "catalog_trigger": "Manual",
 "tags": [
  "target-profile",
  "domain"
 ],
 "dependencies": [
  "dns",
  "rdap"
 ],
 "optional_dependencies": [
  "crtsh",
  "opencorporates"
 ],
 "inputs": [
  {
   "name": "domain",
   "label": "Domain you own or are authorised to examine",
   "type": "domain",
   "required": true,
   "example": "example.org"
  },
  {
   "name": "company",
   "label": "Company name",
   "type": "company",
   "required": true,
   "example": "Example Holdings"
  }
 ],
 "legal_notes": "Applies to verified self-audits and consent-based engagements. Results are leads, not facts; nothing is verified automatically. Every run re-checks the subject's authorization, and revoking it switches the schedule off.",
 "quota_note": "About 4 source request(s) per run",
 "example_output": "A de-duplicated dataset saved as evidence, with every finding linked to its source response.",
 "capability_gaps": [
  "OpenCorporates needs an API token. Beneficial ownership is not available from these sources."
 ],
 "instructions": "Passive registry and DNS data for a domain the subject owns, plus an optional company record. Affiliation stays claimed until corroborated.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "tp-04-owned-domain-and-company-linkage",
  "name": "Owned Domain and Company Linkage",
  "description": "Passive registry and DNS data for a domain the subject owns, plus an optional company record. Affiliation stays claimed until corroborated.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "target-profile",
   "domain"
  ],
  "trigger": {
   "type": "manual",
   "enabled": false
  },
  "inputs": {
   "domain": "example.org",
   "company": "Example Holdings"
  },
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "scope",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "rdap",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "rdap",
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "dns",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "dns",
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "crtsh",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "crtsh",
     "target_ref": "$inputs.domain"
    },
    "optional": true
   },
   {
    "id": "scope_co",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.company",
     "target_type": "company"
    }
   },
   {
    "id": "opencorp",
    "type": "adapter_query",
    "depends_on": [
     "scope_co"
    ],
    "config": {
     "adapter": "opencorporates",
     "target_ref": "$inputs.company",
     "target_type": "company"
    },
    "optional": true
   },
   {
    "id": "merged",
    "type": "transform",
    "depends_on": [
     "rdap",
     "dns",
     "crtsh",
     "opencorp"
    ],
    "config": {
     "ref": "$nodes.rdap.output",
     "extra_refs": [
      "$nodes.dns.output",
      "$nodes.crtsh.output",
      "$nodes.opencorp.output"
     ],
     "op": "merge"
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "merged"
    ],
    "config": {
     "ref": "$nodes.merged.output"
    }
   },
   {
    "id": "review",
    "type": "analyst_review",
    "depends_on": [
     "unique"
    ],
    "config": {
     "prompt": "Registrant data is often redacted. Treat any company link as claimed until a second independent source supports it.",
     "timeout_hours": 168
    }
   },
   {
    "id": "save",
    "type": "evidence_save",
    "depends_on": [
     "review",
     "unique"
    ],
    "config": {
     "ref": "$nodes.unique.output",
     "title": "Domain and company linkage (claims)"
    }
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {
   "domain": "example.org",
   "company": "Example Holdings"
  },
  "adapter_findings": {
   "rdap": [
    {
     "entity": "example.org",
