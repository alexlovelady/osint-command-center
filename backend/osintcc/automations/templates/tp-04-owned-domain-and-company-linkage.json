    }
   ],
   "dns": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "dns.a",
     "value": "192.0.2.10",
     "confidence": "high"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "dns.mx",
     "value": "mail.example.org",
     "confidence": "high"
    }
   ],
   "crtsh": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "cert.subdomain",
     "value": "www.example.org",
     "confidence": "medium"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "cert.subdomain",
     "value": "mail.example.org",
     "confidence": "medium"
    }
   ],
   "opencorporates": [
    {
     "entity": "example.org",
     "entity_type": "org",
     "predicate": "company.jurisdiction",
     "value": "us_de",
     "confidence": "medium"
    }
   ]
  }
 }
}
