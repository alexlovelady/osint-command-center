{
 "slug": "cy-02-domain-change-watch",
 "key": "CY-02",
 "version": 1,
 "category": "Cyber",
 "name": "Domain Change Watch",
 "description": "Compares DNS, registrar and certificate data with the previous run and notifies only on material change.",
 "catalog_trigger": "Daily, disabled",
 "tags": [
  "monitor",
  "passive"
 ],
 "dependencies": [
  "dns",
  "rdap"
 ],
 "optional_dependencies": [
  "crtsh"
 ],
 "inputs": [
  {
   "name": "domain",
   "label": "Domain you own or are authorised to examine",
   "type": "domain",
   "required": true,
   "example": "example.org"
  }
 ],
 "legal_notes": "Public, passive sources only. Respect each source's terms and keep to targets you own or have a documented reason to examine.",
 "quota_note": "About 3 source request(s) per run",
 "example_output": "One notification per window listing new, changed and no-longer-observed records; the first run only records a baseline.",
 "capability_gaps": [],
 "instructions": "Compares DNS, registrar and certificate data with the previous run and notifies only on material change.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "cy-02-domain-change-watch",
  "name": "Domain Change Watch",
  "description": "Compares DNS, registrar and certificate data with the previous run and notifies only on material change.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "monitor",
   "passive"
  ],
  "trigger": {
   "type": "schedule",
   "schedule": "0 8 * * *",
   "timezone": "UTC",
   "enabled": false,
   "missed_run_policy": "coalesce"
  },
  "inputs": {
   "domain": "example.org"
  },
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "scope",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "rdap",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "rdap",
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "dns",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "dns",
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "crtsh",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "crtsh",
     "target_ref": "$inputs.domain"
    },
    "optional": true
   },
   {
    "id": "merged",
    "type": "transform",
    "depends_on": [
     "rdap",
     "dns",
     "crtsh"
    ],
    "config": {
     "ref": "$nodes.rdap.output",
     "extra_refs": [
      "$nodes.dns.output",
      "$nodes.crtsh.output"
     ],
     "op": "merge"
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "merged"
    ],
    "config": {
     "ref": "$nodes.merged.output"
    }
   },
   {
    "id": "diff",
    "type": "snapshot_diff",
    "depends_on": [
     "unique"
    ],
    "config": {
     "dataset_ref": "$nodes.unique.output"
    }
   },
   {
    "id": "notify",
    "type": "notification",
    "depends_on": [
     "diff"
    ],
    "config": {
     "change_ref": "$nodes.diff.output",
     "title": "Domain change detected",
     "severity": "warning",
     "channel": "local_desktop",
     "only_if_changed": true
    }
   },
   {
    "id": "fail",
    "type": "error_handler",
    "depends_on": [
     "unique",
     "diff"
    ],
    "config": {
     "title": "Domain change watch failed"
    },
    "run_on": "failure"
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {
   "domain": "example.org"
  },
  "adapter_findings": {
   "rdap": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "rdap.registrar",
     "value": "Example Registrar Inc",
     "confidence": "high"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "rdap.nameserver",
     "value": "ns1.example.net",
     "confidence": "high"
    }
   ],
   "dns": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "dns.a",
     "value": "192.0.2.10",
     "confidence": "high"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "dns.mx",
     "value": "mail.example.org",
     "confidence": "high"
    }
   ],
   "crtsh": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "cert.subdomain",
     "value": "www.example.org",
     "confidence": "medium"
    },
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "cert.subdomain",
     "value": "mail.example.org",
     "confidence": "medium"
    }
   ]
  },
  "previous_snapshot": [
   {
    "id": "p0",
    "entity": "example.org",
    "entity_type": "domain",
    "predicate": "rdap.registrar",
    "value": "previous-value",
    "confidence": "high",
    "adapter": "rdap"
   },
   {
    "id": "p1",
    "entity": "example.org",
    "entity_type": "domain",
    "predicate": "rdap.nameserver",
    "value": "ns1.example.net",
    "confidence": "high",
    "adapter": "rdap"
   },
   {
    "id": "p2",
    "entity": "example.org",
    "entity_type": "domain",
    "predicate": "dns.a",
    "value": "192.0.2.10",
    "confidence": "high",
    "adapter": "dns"
   },
   {
    "id": "p3",
    "entity": "example.org",
    "entity_type": "domain",
    "predicate": "dns.mx",
    "value": "mail.example.org",
    "confidence": "high",
    "adapter": "dns"
   },
   {
    "id": "p4",
    "entity": "example.org",
    "entity_type": "domain",
    "predicate": "cert.subdomain",
    "value": "www.example.org",
    "confidence": "medium",
    "adapter": "crtsh"
   }
  ]
 }
}
