{
 "slug": "co-05-news-reputation-watch",
 "key": "CO-05",
 "version": 1,
 "category": "Corporate",
 "name": "News & Reputation Watch",
 "description": "Watches public news mentions of a company domain. Mentions are shown as mentions, never as sentiment facts.",
 "catalog_trigger": "Daily, disabled",
 "tags": [
  "media",
  "monitor"
 ],
 "dependencies": [
  "gdelt"
 ],
 "optional_dependencies": [],
 "inputs": [
  {
   "name": "domain",
   "label": "Domain you own or are authorised to examine",
   "type": "domain",
   "required": true,
   "example": "example.org"
  }
 ],
 "legal_notes": "Public, passive sources only. Respect each source's terms and keep to targets you own or have a documented reason to examine.",
 "quota_note": "About 1 source request(s) per run",
 "example_output": "A de-duplicated dataset saved as evidence, with every finding linked to its source response.",
 "capability_gaps": [],
 "instructions": "Watches public news mentions of a company domain. Mentions are shown as mentions, never as sentiment facts.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "co-05-news-reputation-watch",
  "name": "News & Reputation Watch",
  "description": "Watches public news mentions of a company domain. Mentions are shown as mentions, never as sentiment facts.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "media",
   "monitor"
  ],
  "trigger": {
   "type": "schedule",
   "schedule": "0 6 * * *",
   "timezone": "UTC",
   "enabled": false,
   "missed_run_policy": "coalesce"
  },
  "inputs": {
   "domain": "example.org"
  },
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "scope",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "gdelt",
    "type": "adapter_query",
    "depends_on": [
     "scope"
    ],
    "config": {
     "adapter": "gdelt",
     "target_ref": "$inputs.domain"
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "gdelt"
    ],
    "config": {
     "ref": "$nodes.gdelt.output"
    }
   },
   {
    "id": "diff",
    "type": "snapshot_diff",
    "depends_on": [
     "unique"
    ],
    "config": {
     "dataset_ref": "$nodes.unique.output"
    }
   },
   {
    "id": "notify",
    "type": "notification",
    "depends_on": [
     "diff"
    ],
    "config": {
     "change_ref": "$nodes.diff.output",
     "title": "New public news mentions",
     "severity": "info",
     "channel": "local_desktop",
     "only_if_changed": true
    }
   },
   {
    "id": "fail",
    "type": "error_handler",
    "depends_on": [
     "unique",
     "diff"
    ],
    "config": {
     "title": "News watch failed"
    },
    "run_on": "failure"
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {
   "domain": "example.org"
  },
  "adapter_findings": {
   "gdelt": [
    {
     "entity": "example.org",
     "entity_type": "domain",
     "predicate": "news.mention",
     "value": "Example Org announces new service (2026-03-02)",
     "confidence": "low"
    }
   ]
  },
  "previous_snapshot": []
 }
}
