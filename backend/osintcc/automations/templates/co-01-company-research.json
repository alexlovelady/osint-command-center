 ],
 "legal_notes": "SEC EDGAR needs your contact set in Setup and is rate limited. OpenCorporates needs a (free-tier) API token.",
 "quota_note": "About 2 source request(s) per run",
 "example_output": "A de-duplicated dataset saved as evidence, with every finding linked to its source response.",
 "capability_gaps": [],
 "instructions": "Public SEC filings and registry data for a company, de-duplicated and reported with citations.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "co-01-company-research",
  "name": "Company Research",
  "description": "Public SEC filings and registry data for a company, de-duplicated and reported with citations.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "corporate"
  ],
  "trigger": {
   "type": "manual",
   "enabled": false
  },
  "inputs": {
   "cik": "0000000001",
   "company": "Example Holdings"
  },
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "scope_cik",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.cik",
     "target_type": "cik"
    }
   },
   {
    "id": "edgar",
    "type": "adapter_query",
    "depends_on": [
     "scope_cik"
    ],
    "config": {
     "adapter": "sec_edgar",
     "target_ref": "$inputs.cik",
     "target_type": "cik"
    }
   },
   {
    "id": "scope_co",
    "type": "authorization_check",
    "depends_on": [],
    "config": {
     "target_ref": "$inputs.company",
     "target_type": "company"
    }
   },
   {
    "id": "opencorp",
    "type": "adapter_query",
    "depends_on": [
     "scope_co"
    ],
    "config": {
     "adapter": "opencorporates",
     "target_ref": "$inputs.company",
     "target_type": "company"
    },
    "optional": true
   },
   {
    "id": "merged",
    "type": "transform",
    "depends_on": [
     "edgar",
     "opencorp"
    ],
    "config": {
     "ref": "$nodes.edgar.output",
     "extra_refs": [
      "$nodes.opencorp.output"
     ],
     "op": "merge"
    }
   },
   {
    "id": "unique",
    "type": "deduplicate",
    "depends_on": [
     "merged"
    ],
    "config": {
     "ref": "$nodes.merged.output"
    }
   },
   {
    "id": "report",
    "type": "report",
    "depends_on": [
     "unique"
    ],
    "config": {
     "profile": "technical",
     "format": "html"
    }
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {
   "cik": "0000000001",
   "company": "Example Holdings"
  },
  "adapter_findings": {
   "sec_edgar": [
    {
     "entity": "0000000001",
     "entity_type": "org",
     "predicate": "edgar.filing",
     "value": "10-K 2026-02-14",
     "confidence": "high"
    },
    {
     "entity": "0000000001",
     "entity_type": "org",
     "predicate": "edgar.filing",
     "value": "8-K 2026-03-01",
     "confidence": "high"
    }
   ],
   "opencorporates": [
    {
     "entity": "0000000001",
     "entity_type": "org",
     "predicate": "company.jurisdiction",
     "value": "us_de",
     "confidence": "medium"
    }
   ]
  }
 }
}
