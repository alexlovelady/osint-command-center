{
 "slug": "id-06-identity-correlation-review",
 "key": "ID-06",
 "version": 1,
 "category": "Identity",
 "name": "Identity Correlation Review",
 "description": "Suggests links between accounts and emails already in the case and waits for a person to confirm each one.",
 "catalog_trigger": "Manual",
 "tags": [
  "identity",
  "review"
 ],
 "dependencies": [],
 "optional_dependencies": [],
 "inputs": [],
 "legal_notes": "Suggestions only. A shared name or handle is not an identity.",
 "quota_note": "No network requests (works on local data)",
 "example_output": "A de-duplicated dataset saved as evidence, with every finding linked to its source response.",
 "capability_gaps": [],
 "instructions": "Suggests links between accounts and emails already in the case and waits for a person to confirm each one.",
 "maturity": "fixture_tested",
 "definition": {
  "schema_version": 1,
  "workflow_key": "id-06-identity-correlation-review",
  "name": "Identity Correlation Review",
  "description": "Suggests links between accounts and emails already in the case and waits for a person to confirm each one.",
  "owner_scope": "investigation",
  "status": "draft",
  "tags": [
   "identity",
   "review"
  ],
  "trigger": {
   "type": "manual",
   "enabled": false
  },
  "inputs": {},
  "policy": {
   "network_mode": "passive_only",
   "max_requests_per_provider_per_run": 50,
   "max_duration_seconds": 600,
   "max_concurrent_nodes": 2,
   "reentrancy": "skip"
  },
  "nodes": [
   {
    "id": "accounts",
    "type": "case_findings",
    "depends_on": [],
    "config": {
     "entity_types": [
      "account"
     ]
    }
   },
   {
    "id": "emails",
    "type": "case_findings",
    "depends_on": [],
    "config": {
     "entity_types": [
      "email"
     ]
    }
   },
   {
    "id": "corr",
    "type": "correlate",
    "depends_on": [
     "accounts",
     "emails"
    ],
    "config": {
     "refs": [
      "$nodes.accounts.output",
      "$nodes.emails.output"
     ]
    }
   },
   {
    "id": "review",
    "type": "analyst_review",
    "depends_on": [
     "corr"
    ],
    "config": {
     "prompt": "Review every suggested link. Nothing is merged automatically; merge in the Graph tab only what you can support.",
     "timeout_hours": 72
    }
   },
   {
    "id": "save",
    "type": "evidence_save",
    "depends_on": [
     "review",
     "corr"
    ],
    "config": {
     "ref": "$nodes.corr.output",
     "title": "Suggested identity links (unconfirmed)"
    }
   }
  ],
  "error_policy": {
   "transient_retries": 2,
   "backoff": "exponential_jitter",
   "fail_closed_on_scope_error": true
  }
 },
 "fixture": {
  "inputs": {},
  "adapter_findings": {},
  "case_findings": [
   {
    "entity": "alice@example.org",
    "entity_type": "email",
    "predicate": "email.address",
    "value": "alice"
   },
   {
    "entity": "alice",
    "entity_type": "account",
    "predicate": "email.address",
    "value": "alice"
   }
  ]
 }
}
